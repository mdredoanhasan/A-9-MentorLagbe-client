# Server-only Stripe key. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Optional overrides for the one-time Pro prices configured in Stripe.
STRIPE_TUTOR_PRO_PRICE_ID=
STRIPE_STUDENT_PRO_PRICE_ID=

# Legacy price override remains supported for old Stripe sessions.
# STRIPE_MENTOR_PRO_PRICE_ID=

# Required for Stripe to activate Pro if the customer closes the return page.
STRIPE_WEBHOOK_SECRET=

# Hosted Checkout redirects to Stripe and does not require the publishable key.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
